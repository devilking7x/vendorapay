# Vendora Pay AI — copy to .env, never commit secrets.
# Demo mode works with everything at defaults (PAYPAL_MOCK=1).

# 1 = simulated PayPal end-to-end (no network). 0 + keys below = real sandbox.
PAYPAL_MOCK=1
# Get free sandbox keys at https://developer.paypal.com (REST API app).
# NEVER commit these, NEVER paste them in chat — dashboard env vars only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox REST base (override only if you know why)
# PAYPAL_API_URL=https://api-m.sandbox.paypal.com

# Optional: genuine AI copy via NVIDIA Nemotron on Nebius (OpenAI-compatible).
# Without it, the honest smart-template engine is used and the UI says so.
NEBIUS_API_KEY=
# NEBIUS_API_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2

PORT=3000
